{
  "name": "ha-3d-rooms",
  "version": "0.43.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node tools/mdi-catalog.mjs",
    "dev": "node server/index.mjs",
    "build": "vite build && vite build --config vite.card.config.mjs && vite build --config vite.standalone.config.mjs && node tools/build-card.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "example": "node tools/create-example.mjs",
    "format": "prettier --write server shared web dashboard tools test vite*.config.mjs",
    "format:check": "prettier --check server shared web dashboard tools test vite*.config.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@mdi/js": "7.4.47",
    "fflate": "^0.8.2",
    "home-assistant-js-websocket": "9.8.1",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "three": "^0.186.0",
    "ws": "^8.18.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@mdi/svg": "7.4.47",
    "prettier": "^3.9.10",
    "vite": "^8.3.0"
  }
}
